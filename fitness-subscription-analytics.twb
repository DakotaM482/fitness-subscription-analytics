      <column caption='Customer Cohort' datatype='real' name='[Calculation_0055550243377153]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Transaction_Date]{FIXED [Customer_ID] : MIN([Transaction_Date])}' />
      </column>
      <column caption='First Purchase Date' datatype='date' name='[Calculation_0055550244204546]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [Customer_ID] : MIN([Transaction_Date]) }' />
      </column>
      <column caption='Cohort Month' datatype='datetime' name='[Calculation_0055550246035459]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;,[Calculation_0055550244204546])' />
      </column>
      <column caption='Months Since First Purchase' datatype='integer' name='[Calculation_0055550247047172]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&#13;&#10;    &apos;month&apos;,&#13;&#10;    [Calculation_0055550244204546],&#13;&#10;    [Transaction_Date]&#13;&#10;)' />
      </column>
      <column caption='Active Customers' datatype='integer' name='[Calculation_0055550247247877]' role='measure' type='quantitative'>
